{
  "name": "agents-dashboard",
  "productName": "Agents Dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Run several AI coding agents side by side, each in its own terminal and project folder",
  "author": "Andrei Cicortas",
  "homepage": "https://github.com/andrei-cicortas/agents-dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrei-cicortas/agents-dashboard.git"
  },
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.andreicicortas.agentsdashboard",
    "productName": "Agents Dashboard",
    "copyright": "Copyright © 2026 Andrei Cicortas",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "app/**",
      "server/**",
      "shared/**",
      "web/**",
      "config/**",
      "assets/icon.ico",
      "package.json",
      "!**/*.pdb"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agents-Dashboard-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agents Dashboard",
      "uninstallDisplayName": "Agents Dashboard",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "andrei-cicortas",
        "repo": "agents-dashboard",
        "releaseType": "draft"
      }
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andrei-cicortas/agents-dashboard/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "electron",
    "terminal",
    "xterm",
    "node-pty",
    "windows",
    "developer-tools"
  ]
}
